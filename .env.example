# Local defaults. Never commit private keys or RPC credentials.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
PORT=3001
# For Sepolia set RPC_URL, CHAIN_ID=11155111 and DEPLOYER_PRIVATE_KEY.
# DEPLOYER_PRIVATE_KEY=
# Optional deployment file, relative to project root:
# DEPLOYMENT_FILE=deployments/11155111.json
# Render can use these instead of a deployment file:
# CONTRACT_ADDRESS=0x...
# DEPLOYMENT_BLOCK=12345678
# DEPLOYMENT_TX_HASH=0x...
# DEPLOYED_AT=2026-10-01T00:00:00.000Z
# HOST=127.0.0.1

